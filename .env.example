# ── SUPABASE (servidor) ─────────────────────────────────────────
# Supabase Dashboard → Project Settings → API (URL) e API Keys (chaves).
# Lidas por process.env nas Server Functions (SSR): src/integrations/supabase/*.ts, src/lib/*.functions.ts
# URL do projeto: https://<ref>.supabase.co
SUPABASE_URL=""
# Chave pública (sb_publishable_...). Respeita as regras de RLS.
SUPABASE_PUBLISHABLE_KEY=""
# Chave SECRETA (sb_secret_...). Ignora RLS: só no servidor, nunca com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=""
# Ref do projeto (o trecho antes de .supabase.co).
SUPABASE_PROJECT_ID=""

# ── SUPABASE (navegador) ────────────────────────────────────────
# Réplicas para o bundle do cliente (import.meta.env em src/integrations/supabase/client.ts).
# Vão para o navegador: use apenas valores públicos.
# Igual a SUPABASE_URL.
VITE_SUPABASE_URL=""
# Igual a SUPABASE_PUBLISHABLE_KEY (nunca a secreta).
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Igual a SUPABASE_PROJECT_ID.
VITE_SUPABASE_PROJECT_ID=""

# ── GOOGLE PLACES (diagnóstico do Google Meu Negócio) ───────────
# Google Cloud Console → APIs e serviços → Credenciais. Ative a Places API (New).
# Usada só no servidor, em src/lib/simulador.functions.ts.
# Chave principal da Places API (AIza...).
GOOGLE_PLACES_API_KEY=""
# Opcional: alternativa usada se GOOGLE_PLACES_API_KEY estiver vazia.
GOOGLE_MAPS_API_KEY=""

# ── GOOGLE GEMINI (estratégia dos leads) ────────────────────────
# aistudio.google.com → Get API key. Usada só no servidor, em src/lib/leads.functions.ts.
# Chave do Google AI Studio (AIza...).
GEMINI_API_KEY=""
# Modelo do Gemini. Vazio usa gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"

# ── DRIZZLE / MIGRAÇÕES (opcional, só para drizzle-kit) ─────────
# Supabase → Connect → connection string Postgres (6543 pooler ou 5432 direta). Contém senha: segredo.
# postgresql://postgres.<ref>:<senha>@<host>:6543/postgres
DATABASE_URL=""
